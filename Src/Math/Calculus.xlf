Number Derivative(Func Function, Number x, Number h)
{
    =LAMBDA(f,x,[h],
        LET(dx, IF(ISOMITTED(h),h,0.000001),
            (f(x+dx)-f(x-dx))/(2*dx)
        )
    )
}

Number Integrate(Func Function, Number Start, Number End, Number Steps)
{
    =LAMBDA(f,Start,End,Steps,
        LET(
            dx, (End-Start)/Steps,
            x , SEQUENCE(Steps+1,,Start,dx),
            y , MAP(x,f),
            dx*(SUM(y)-((INDEX(y,1)+INDEX(y,Steps+1))/2))
        )
    )
}