Number Mean(Array_Anything Array)
{
    =LAMBDA(Array, AVERAGE(Array))
}


Number Median(Array_Anything Array)
{
    =LAMBDA(Array, MEDIAN(Array))
}


Number Variance(Array_Anything Array)
{
    =LAMBDA(Array, VAR.S(Array))
}


Number StandardDeviation(Array_Anything Array)
{
    =LAMBDA(Array, STDEV.S(Array))
}


Number Normalize(Number Input, Number Minimum, Number Maximum)
{
    =LAMBDA(x,Min,Max, (x-Min)/(Max-Min))
}

Number Min(Number A, Number B)
{
    =LAMBDA(A,B, MIN(A,B))
}


Number Max(Number A, Number B)
{
    =LAMBDA(A,B, MAX(A,B))
}


Number Average(Number A, Number B)
{
    =LAMBDA(A,B, (A+B)/2)
}


Number Hypotenuse(Number A, Number B)
{
    =LAMBDA(A,B, SQRT(A^2+B^2))
}


Number ToPercent(Number Input)
{
    =LAMBDA(x, x*100)
}


Number FromPercent(Number Input)
{
    =LAMBDA(x, x/100)
}