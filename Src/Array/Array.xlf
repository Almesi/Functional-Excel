Func Head(Array_Anything Array)
{
    =LAMBDA(Array,
        TAKE(Array,1)
    )
}

Func Tail(Array_Anything Array)
{
    =LAMBDA(Array,
        DROP(Array,1)
    )
}

Func Take(Number N, Array_Anything Array)
{
    =LAMBDA(N,Array,
        TAKE(Array,N)
    )
}

Func Drop(Number N, Array_Anything Array)
{
    =LAMBDA(N,Array,
        DROP(Array,N)
    )
}

Func Zip(Array_Anything A, Array_Anything B)
{
    =LAMBDA(A,B,
        HSTACK(A,B)
    )
}

Func ZipWith(Func Function, Array_Anything A, Array_Anything B)
{
    =LAMBDA(Function,A,B,
        MAP(
            A,
            B,
            Function
        )
    )
}

Func Map(Func Function, Array_Anything Array)
{
    =LAMBDA(Function,Array,
        MAP(
            Array,
            Function
        )
    )
}

Func Filter(Func Predicate, Array_Anything Array)
{
    =LAMBDA(Predicate,Array,
        FILTER(
            Array,
            MAP(Array,Predicate)
        )
    )
}

Func Reduce(Func Function, Anything Initial, Array_Anything Array)
{
    =LAMBDA(Function,Initial,Array,
        REDUCE(
            Initial,
            Array,
            LAMBDA(Accumulator,Value,
                Function(Accumulator,Value)
            )
        )
    )
}

Func Scan(Func Function, Anything Initial, Array_Anything Array)
{
    =LAMBDA(Function,Initial,Array,
        SCAN(
            Initial,
            Array,
            LAMBDA(Accumulator,Value,
                Function(Accumulator,Value)
            )
        )
    )
}